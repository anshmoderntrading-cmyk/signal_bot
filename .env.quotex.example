# Copy this file to ".env" and fill in your details
DATA_SOURCE=quotex
# Make a NEW bot in @BotFather for OTC (don't use the Render bot's token)
TELEGRAM_BOT_TOKEN=paste_new_bot_token_here
QUOTEX_EMAIL=your_quotex_email
QUOTEX_PASSWORD=your_quotex_password
SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,AUDJPY,EURJPY,GBPJPY,USDCAD,NZDUSD,EURGBP
EXPIRY_MINUTES=1
SIGNAL_EVERY_MINUTES=2
SEND_RESULTS=1
